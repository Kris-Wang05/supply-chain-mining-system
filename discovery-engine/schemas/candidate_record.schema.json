{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/candidate_record.schema.json",
  "title": "CandidateRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ticker",
    "company",
    "exchange",
    "country",
    "event_date",
    "event_type",
    "relationship_level",
    "counterparty",
    "summary",
    "why_mentioned",
    "unilateral",
    "economic_impact_note",
    "price_reaction_note",
    "sources",
    "scores",
    "discovery_score",
    "status",
    "review_by",
    "fingerprint",
    "captured_at",
    "score_rationale"
  ],
  "properties": {
    "ticker": { "type": "string", "minLength": 1 },
    "company": { "type": "string", "minLength": 1 },
    "exchange": { "type": "string", "minLength": 1 },
    "country": { "type": "string", "minLength": 1 },
    "event_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "event_type": {
      "type": "string",
      "enum": [
        "customer_or_supplier_mention",
        "formal_agreement",
        "design_win_or_qualification",
        "second_source_adoption",
        "ma_or_strategic_investment",
        "government_contract",
        "subsidy_or_policy",
        "regulatory_approval",
        "export_restriction_or_localization",
        "financial_inflection",
        "backlog_or_order_growth",
        "guidance_raise",
        "capacity_addition",
        "new_product_revenue",
        "asset_event",
        "insider_buying",
        "buyback_or_capital_allocation",
        "debt_restructuring",
        "industry_structure_change"
      ]
    },
    "relationship_level": { "type": "string", "enum": ["A", "B", "C", "D", "E"] },
    "counterparty": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "why_mentioned": { "type": "string", "minLength": 1 },
    "unilateral": { "type": "boolean" },
    "economic_impact_note": { "type": "string", "minLength": 1 },
    "price_reaction_note": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "publisher", "published_date", "captured_at", "tier", "excerpt"],
        "properties": {
          "url": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "published_date": { "type": "string", "minLength": 1 },
          "captured_at": { "type": "string", "minLength": 1 },
          "tier": { "type": "integer", "enum": [1, 2, 3] },
          "excerpt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_score",
        "evidence_score",
        "economic_impact_score",
        "recognition_gap_score"
      ],
      "properties": {
        "change_score": { "type": "integer", "minimum": 0, "maximum": 5 },
        "evidence_score": { "type": "integer", "minimum": 0, "maximum": 5 },
        "economic_impact_score": { "type": "integer", "minimum": 0, "maximum": 5 },
        "recognition_gap_score": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    },
    "discovery_score": { "type": "integer", "minimum": 0, "maximum": 20 },
    "status": {
      "type": "string",
      "enum": [
        "lead",
        "contextualized",
        "verified",
        "candidate",
        "promoted",
        "watchlist",
        "rejected",
        "expired"
      ]
    },
    "review_by": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "fingerprint": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string", "minLength": 1 },
    "score_rationale": { "type": "string", "minLength": 1 },
    "supersedes": { "type": "string" },
    "red_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "unilateral_claim_only",
          "no_contract_value",
          "many_similar_partners",
          "recycled_news",
          "conflicts_with_filings",
          "promo_name_dropping",
          "price_already_moved",
          "dilution_or_insider_selling",
          "governance_risk",
          "low_liquidity"
        ]
      }
    },
    "mispricing_hypothesis": { "type": "string" },
    "falsification_signals": { "type": "array", "items": { "type": "string" } },
    "kill_rules_triggered": { "type": "array", "items": { "type": "string" } },
    "next_questions": { "type": "array", "items": { "type": "string" } },
    "outcome_note": { "type": "string" }
  }
}
